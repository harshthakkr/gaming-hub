generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  createdAt      DateTime         @default(now())
  name           String?
  username       String?          @unique
  email          String           @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  post           Post[]
  comment        Comment[]
  accounts       Account[]
  sessions       Session[]
  reviews        Review[]
  reviewLikes    ReviewLike[]
  reviewComments ReviewComment[]
  commentLikes   CommentLike[]
  chatMessages   ChatMessage[]
  collection     CollectionItem[]

  @@map("users")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  role      ChatRole
  content   String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Post {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  title     String
  body      String?
  tag       String
  upvote    Int       @default(0)
  downvote  Int       @default(0)
  comment   Comment[]
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
}

model Comment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  text      String
  upvote    Int      @default(0)
  downvote  Int      @default(0)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
}

/// Player verdict tiers. Ordered worst -> best; the UI renders them in this
/// order and picks the modal tier as the game's consensus.
enum Verdict {
  SKIP
  TIMEPASS
  WORTH_IT
  GO_FOR_IT
  MASTERPIECE
}

model Review {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// IGDB game id — games are not mirrored locally, so this is a loose ref.
  gameId      Int
  gameSlug    String
  gameName    String
  body        String
  wordCount   Int
  verdict     Verdict
  hasSpoilers Boolean  @default(false)

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  likes    ReviewLike[]
  comments ReviewComment[]

  @@unique([authorId, gameId])
  @@index([gameId, createdAt])
  @@index([gameId, hasSpoilers])
}

model ReviewLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  @@unique([reviewId, userId])
  @@index([userId])
}

model ReviewComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  body      String

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  /// Replies are capped at one level: a comment with a parent cannot be replied to.
  parent   ReviewComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  ReviewComment[] @relation("CommentReplies")

  likes CommentLike[]

  @@index([reviewId, createdAt])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  comment   ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([commentId, userId])
  @@index([userId])
}

enum CollectionKind {
  WISHLIST
  LIBRARY
}

/// A game a user has wishlisted or added to their library.
model CollectionItem {
  id        String         @id @default(cuid())
  createdAt DateTime       @default(now())
  kind      CollectionKind
  /// IGDB game id — games are not mirrored locally, so this is a loose ref.
  gameId    Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, kind, gameId])
}
